# MySQL — the API routes and the migration script both read these.

# Set to "true" for managed hosts (RDS, PlanetScale, Aiven) that require TLS.
MYSQL_SSL=false

# Gmail account used to send the report and the admin notification.


# Where images and the intro video load from. Leave unset for the public/ folder of the S3 bucket;
# set it empty to serve them from this app's own public/ folder instead.
# NEXT_PUBLIC_ASSET_BASE=

# The live domain (no trailing slash), for share previews, the sitemap and robots.txt. Needed at build time.
NEXT_PUBLIC_SITE_URL=https://your-domain.com
